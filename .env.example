# EvoKit environment configuration — TEMPLATE.
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` is gitignored; never commit real secrets.
#
# Config YAMLs expand ${VAR} / ${VAR:-default} at load time (evokit/loader.py),
# and the run scripts read VLLM_BASE_URL / LLM_MODEL from the environment.

# -----------------------------------------------------------------------------
# Self-hosted vLLM (provider: "vllm")
# -----------------------------------------------------------------------------
# OpenAI-compatible endpoint of your vLLM server. The 3-seed run scripts default
# to http://localhost:8000/v1 when this is unset.
VLLM_BASE_URL=http://localhost:8000/v1

# Model id served by vLLM (and the default used by the example run scripts).
LLM_MODEL=mistralai/Devstral-Small-2-24B-Instruct-2512

# -----------------------------------------------------------------------------
# Cloud API providers (provider: "openai" against a hosted endpoint)
# Reference these from a config with, e.g., api_key: "${OPENAI_API_KEY}".
# Only set the one(s) you actually use.
# -----------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (OpenAI-compatible gateway to many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
